# Copy this file to .env and fill in real values. Never commit .env.
# Every value below is a placeholder.

# Required. Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-value
ECOMMERCE_DATABASE=/absolute/path/to/EcommerceDB
SESSION_COOKIE_SECURE=0

# Public address of the site; used for the link inside password-reset emails.
APP_BASE_URL=http://127.0.0.1:5000

# Password reset emails (https://resend.com). Without these no email is sent.
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=LumaMarket <onboarding@resend.dev>

# Weather (https://openweathermap.org/api). Without it the Weather page shows a friendly error.
OPENWEATHER_API_KEY=your-openweather-key

# IP-based location on the Weather page (1 = on, 0 = off) and proxy support.
# GEOIP_ENABLED=1
# TRUST_PROXY=1   # automatic on Render; set it yourself behind other proxies

# Google sign-in. Leave empty to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Optional; must exactly match an Authorized redirect URI in Google Cloud.
# GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/callback

# Optional
# CURRENCY=$
# UPLOAD_DIR=/absolute/path/for/product/images

# Set only while running setup_admin.py:
# ADMIN_EMAIL=you@example.com
# ADMIN_NAME=Your Name
# ADMIN_PASSWORD=use-a-secret-manager-instead-of-committing-this
