SECRET_KEY=replace-with-a-long-random-value
ECOMMERCE_DATABASE=/absolute/path/to/EcommerceDB
SESSION_COOKIE_SECURE=0
# Google sign-in (see README). Leave empty to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Optional; must exactly match an Authorized redirect URI in Google Cloud.
# GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/callback
# Set only while running setup_admin.py:
# ADMIN_PASSWORD=use-a-secret-manager-instead-of-committing-this

